# husky's hook runner invokes this via `sh`; on systems where `sh` is dash the
# bash-specific syntax below fails to parse. Re-exec under bash when we weren't
# started by it. POSIX-safe test; no-op in bash.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

#
# pre-commit — lint-staged's auto-fixes, then the whole gate (scripts/gate.sh,
# the same script `pnpm gate` and CI run): every check, the unit tests, Storybook
# and the build in parallel, then the e2e suite alone across isolated Foundry
# worlds, as foundry-system's hook runs it.
#

set -u

ROOT="$(git rev-parse --show-toplevel)"

# lint-staged writes back to source, so it finishes before anything reads it.
echo "[pre-commit] lint-staged"
pnpm exec lint-staged --hide-unstaged || exit 1

GATE_LABEL=pre-commit exec bash "${ROOT}/scripts/gate.sh"
