{
    "name": "zephyrex-cartography",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.1.1",
    "license": "AGPL-3.0-or-later",
    "description": "Standalone scene authoring for Foundry VTT v13+: terrain, roads/rivers, and native-document structures.",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
        "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
        "lint": "eslint src/ .storybook/ tests/ *.config.ts --ext .ts",
        "lint:fix": "eslint src/ .storybook/ tests/ *.config.ts --ext .ts --fix",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build --quiet",
        "test:storybook": "storybook build --quiet && playwright test -c playwright.storybook.config.ts",
        "test:e2e": "node scripts/run-e2e.mjs",
        "e2e:ratchet": "node scripts/e2e-ratchet.mjs",
        "e2e:ratchet:update": "node scripts/e2e-ratchet.mjs --update",
        "lint:biome": "biome lint src/",
        "format": "prettier --check 'src/**/*.{ts,json,css}'",
        "format:fix": "prettier --write 'src/**/*.{ts,json,css}'",
        "stylelint": "stylelint 'src/**/*.css'",
        "stylelint:fix": "stylelint 'src/**/*.css' --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
        "coverage:ratchet:update": "node scripts/coverage-ratchet.mjs --update",
        "symmetry": "node scripts/symmetry.mjs",
        "type-coverage": "type-coverage --strict --no-detail",
        "knip": "knip",
        "deps:check": "depcruise --config .dependency-cruiser.cjs src",
        "size-limit": "size-limit",
        "schema:gen": "node scripts/gen-schema.mjs",
        "schema:check": "node scripts/gen-schema.mjs --check",
        "lint:ratchet": "node scripts/lint-ratchet.mjs",
        "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
        "biome:ratchet": "node scripts/biome-ratchet.mjs",
        "biome:ratchet:update": "node scripts/biome-ratchet.mjs --update",
        "ts:ratchet": "node scripts/ts-ratchet.mjs",
        "strict:ratchet": "node scripts/strict-ratchet.mjs",
        "test:typecheck:ratchet": "node scripts/strict-ratchet.mjs --config tsconfig.test.json --baseline .test-typecheck-baseline --report .test-typecheck-coverage.json --label test-typecheck-ratchet",
        "type-coverage:ratchet": "node scripts/type-coverage-ratchet.mjs",
        "knip:ratchet": "node scripts/knip-ratchet.mjs",
        "deps:ratchet": "node scripts/depcruise-ratchet.mjs",
        "lockfile:validate": "node scripts/lockfile-validate.mjs",
        "check": "pnpm lint && pnpm lint:biome && pnpm format && pnpm stylelint && pnpm typecheck && pnpm typecheck:tests && pnpm test && pnpm type-coverage && pnpm knip && pnpm deps:check && pnpm build && pnpm size-limit",
        "gate": "pnpm format && pnpm stylelint && pnpm typecheck && pnpm typecheck:tests && pnpm test:coverage && pnpm coverage:ratchet && pnpm symmetry && pnpm schema:check && pnpm lint:ratchet && pnpm biome:ratchet && pnpm ts:ratchet && pnpm strict:ratchet && pnpm test:typecheck:ratchet && pnpm type-coverage:ratchet && pnpm knip:ratchet && pnpm deps:ratchet && pnpm lockfile:validate && pnpm build && pnpm size-limit && pnpm test:e2e && pnpm e2e:ratchet && pnpm test:storybook",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@playwright/test": "^1.59.1",
        "@size-limit/preset-app": "^12.1.0",
        "@storybook/addon-a11y": "^10.6.0",
        "@storybook/html-vite": "^10.6.0",
        "@total-typescript/ts-reset": "^0.6.1",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "@typhonjs-fvtt/eslint-config-foundry.js": "0.8.0",
        "@vitest/coverage-v8": "^4.1.6",
        "@vitest/eslint-plugin": "^1.6.17",
        "autoprefixer": "^10.5.0",
        "dependency-cruiser": "^17.4.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "8.5.0",
        "eslint-import-resolver-typescript": "^3.6.3",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "4.2.1",
        "eslint-plugin-promise": "^6.6.0",
        "eslint-plugin-storybook": "^10.6.0",
        "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
        "happy-dom": "^20.9.0",
        "husky": "^9.1.7",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "knip": "^6.12.2",
        "lint-staged": "^17.0.4",
        "postcss": "^8.5.14",
        "postcss-import": "^16.1.1",
        "postcss-nested": "^7.0.2",
        "prettier": "2.8.8",
        "size-limit": "^12.1.0",
        "storybook": "^10.6.0",
        "stylelint": "^17.11.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.1",
        "tailwindcss": "^3.4.19",
        "type-coverage": "^2.29.7",
        "typescript": "^5.9.3",
        "v8-to-istanbul": "^9.3.0",
        "vite": "^8.0.12",
        "vitest": "^4.1.6"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "biome lint --fix --no-errors-on-unmatched",
            "prettier --write"
        ],
        "*.{json,css}": [
            "prettier --write"
        ]
    },
    "size-limit": [
        {
            "name": "zephyrex-cartography.js (built ESM)",
            "path": "dist/zephyrex-cartography.js",
            "limit": "512 kB"
        }
    ],
    "dependencies": {
        "zod": "^4.6.5"
    }
}
