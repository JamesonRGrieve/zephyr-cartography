                "type": "door",
                "animation": {
                    "type": "slide",
                    "duration": 500,
                    "texture": "stamps/door-closed.svg"
                },
                "sound": "slidingMetal"
            },
            "variants": [
                {
                    "state": "closed",
                    "image": "stamps/door-closed.svg",
                    "width": 100,
                    "height": 20,
                    "doorState": "closed"
                },
                {
                    "state": "open",
                    "image": "stamps/door-open.svg",
                    "width": 100,
                    "height": 20,
                    "doorState": "open"
                }
            ]
        },
        {
            "id": "crate",
            "name": "Crate",
            "category": "Storage",
            "tags": [
                "loot"
            ],
            "scale": "interior",
            "perspective": "top-down",
            "occlusion": {
                "shape": "bounds"
            },
            "physical": {
                "height": 1,
                "cover": 0.5,
                "blocksMovement": true
            },
            "container": {
                "type": "vault",
                "closed": true,
                "locked": false,
                "distance": 1,
                "canInspectItems": true,
                "displayItemTypes": false,
                "sounds": {
                    "open": "sounds/silence.wav",
                    "close": "sounds/silence.wav",
                    "locked": "sounds/silence.wav",
                    "unlocked": "sounds/silence.wav"
                }
            },
            "variants": [
                {
                    "state": "shut",
                    "image": "stamps/crate.svg",
                    "width": 100,
                    "height": 100
                },
                {
                    "state": "smashed",
                    "image": "stamps/crate-smashed.svg",
                    "width": 100,
                    "height": 100,
                    "occlusion": {
                        "shape": "none"
                    },
                    "container": false,
                    "particles": [
                        {
                            "textures": [
                                "stamps/smoke.svg"
                            ],
                            "area": {
                                "x": 0.5,
                                "y": 0.6,
                                "radius": 0.3
                            },
                            "count": 12,
                            "lifetime": [
                                1500,
                                3000
                            ],
