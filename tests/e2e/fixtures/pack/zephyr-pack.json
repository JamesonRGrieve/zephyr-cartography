            "id": "lamp",
            "name": "Lamp",
            "category": "Lighting",
            "scale": "interior",
            "perspective": "top-down",
            "light": {
                "dim": 4,
                "bright": 2,
                "color": "#ffcc88"
            },
            "sound": {
                "path": "sounds/silence.wav",
                "radius": 3
            },
            "variants": [
                {
                    "state": "lit",
                    "image": "stamps/lamp-lit.svg",
                    "width": 100,
                    "height": 100
                },
                {
                    "state": "unlit",
                    "image": "stamps/lamp-unlit.svg",
                    "width": 100,
                    "height": 100,
                    "light": null,
                    "sound": null
                }
            ]
        },
        {
            "id": "chest",
            "name": "Chest",
            "category": "Storage",
            "tags": [
                "loot"
            ],
            "scale": "interior",
            "perspective": "top-down",
            "role": "storage",
            "placement": {
                "against": "wall"
            },
            "container": {
                "states": {
                    "closed": "shut",
                    "open": "open"
                }
            },
            "variants": [
                {
                    "state": "shut",
                    "image": "stamps/crate.svg",
                    "width": 100,
                    "height": 100
                },
                {
                    "state": "open",
                    "image": "stamps/crate.svg",
                    "width": 100,
                    "height": 100
                }
            ]
        },
        {
